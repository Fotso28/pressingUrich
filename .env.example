# Neon : chaîne de connexion « pooled » ou directe (sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique de l'app (http://localhost:3000 en local)
BETTER_AUTH_URL=http://localhost:3000
# Utilisés uniquement par `pnpm db:seed` pour créer le premier gérant
SEED_ADMIN_USERNAME=gerant
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Gérant
